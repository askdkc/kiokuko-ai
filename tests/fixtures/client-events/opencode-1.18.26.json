{
  "schemaVersion": 1,
  "client": {
    "kind": "opencode",
    "version": "1.18.26"
  },
  "capture": {
    "status": "verified",
    "method": "Allowlisted OpenCode host event capture for the current tested release"
  },
  "events": [
    {
      "channel": "event",
      "type": "session.created",
      "sessionId": "<session-id>"
    },
    {
      "channel": "tool.execute.before",
      "tool": "bash",
      "sessionId": "<session-id>",
      "callId": "<call-id>"
    },
    {
      "channel": "shell.env",
      "sessionId": "<session-id>",
      "callId": "<call-id>",
      "environmentNames": []
    },
    {
      "channel": "tool.execute.after",
      "tool": "bash",
      "sessionId": "<session-id>",
      "callId": "<call-id>",
      "result": {
        "exit": 0,
        "truncated": false,
        "output": "<bounded-tool-result>"
      }
    },
    {
      "channel": "event",
      "type": "session.idle",
      "sessionId": "<session-id>",
      "messageId": "<message-id>"
    }
  ]
}
