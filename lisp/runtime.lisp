;; SBCL Common Lisp adapter. No user/system init or third-party package loader.
(defpackage :kiokuko-wire (:use :cl))
(in-package :kiokuko-wire)
(defvar *wire* (sb-sys:make-fd-stream 3 :input t :output t :element-type 'character :external-format :utf-8 :buffering :none))
(defvar *remaining* 8192) ; UTF-8 response <=32 KiB, including printed values.
(define-condition output-limit (error) ())
(defclass bounded-output (sb-gray:fundamental-character-output-stream)
  ((text :initform (make-array 0 :element-type 'character :adjustable t :fill-pointer 0) :reader text)))
(defmethod sb-gray:stream-write-char ((stream bounded-output) character)
  (when (minusp (decf *remaining*)) (error 'output-limit))
  (vector-push-extend character (text stream)) character)
(defmethod sb-gray:stream-line-column ((stream bounded-output)) (declare (ignore stream)) nil)
(defun unhex (text)
  (let ((bytes (make-array (/ (length text) 2) :element-type '(unsigned-byte 8))))
    (dotimes (i (length bytes)) (setf (aref bytes i) (parse-integer text :start (* i 2) :end (+ 2 (* i 2)) :radix 16)))
    (sb-ext:octets-to-string bytes :external-format :utf-8)))
(defun hex (text)
  (with-output-to-string (stream)
    (loop for byte across (sb-ext:string-to-octets text :external-format :utf-8) do (format stream "~2,'0X" byte))))
(defun evaluate-source (source)
  (let* ((*remaining* 8192) (output (make-instance 'bounded-output))
         (*standard-output* output) (*error-output* output) (*trace-output* output)
         (*debug-io* (make-two-way-stream (make-string-input-stream "") output))
         (*query-io* *debug-io*) (*terminal-io* *debug-io*)
         (*print-circle* t) (*print-level* 12) (*print-length* 100) (status "ok"))
    (handler-case
        (with-input-from-string (input source)
          (loop with eof = (gensym) for form = (read input nil eof) until (eq form eof)
                do (let ((values (multiple-value-list (eval form))))
                     (format output "~&=> ") (write values :stream output) (terpri output))))
      (output-limit () (setf status "output_limit"))
      (error (condition)
        (setf status "error")
        (handler-case (format output "~&~A: ~A" (type-of condition) condition) (output-limit () nil))))
    (values status (coerce (text output) 'string))))
;; Evaluation occurs in a separate package; package/state persists only in this worker.
(defpackage :kiokuko-user (:use :cl))
(let ((*package* (find-package :kiokuko-user)))
  (write-line "ready" *wire*) (finish-output *wire*)
  (loop for line = (read-line *wire* nil nil) while line do
    (let* ((space (position #\Space line)) (id (subseq line 0 space))
           (source (unhex (subseq line (1+ space)))))
      (multiple-value-bind (status output) (evaluate-source source)
        (format *wire* "~A ~A ~A~%" id status (hex output)) (finish-output *wire*)))))
